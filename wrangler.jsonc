{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app112",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "7a07e05a-a569-466c-9e28-646f9c6595f2","database_name": "web-app223" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "ae817c0acfbf4e69977bbf82efb84e28" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
